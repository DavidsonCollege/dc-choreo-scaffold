{
  "comment": "The single source of the exact versions a paved-road app starts with. create writes these into package.json; verify reports any drift from them. The layer is installed from its GitHub Release, not a registry.",
  "node": {
    "engines": "^22.22.3 || ^24.15.0",
    "nvmrc": "22"
  },
  "layer": {
    "name": "@davidson/choreo-layer",
    "release": "https://github.com/DavidsonCollege/dc-choreo-scaffold/releases/download/v{version}/davidson-choreo-layer-{version}.tgz"
  },
  "dependencies": {
    "nuxt": "4.6.1",
    "vue": "3.5.43",
    "vue-router": "5.4.0",
    "pinia": "4.0.3",
    "@pinia/nuxt": "1.0.2"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13"
  }
}
